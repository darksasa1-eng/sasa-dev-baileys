{
  "name": "@sasadevofc/baileys",
  "version": "1.0.0-beta.2",
  "description": "Ultra-modern WhatsApp Web automation library for bots and tools. Multi-device. Fast. Developer-first.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-bot",
    "whatsapp-api",
    "baileys",
    "sasadev",
    "multi-device",
    "automation"
  ],
  "author": "SASA DEV <dev@sasadev.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasadev/baileys.git"
  },
  "dependencies": {
    "protobufjs": "^7.2.5",
    "pino": "^8.16.0",
    "ws": "^8.14.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/ws": "^8.5.5",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
